{
  "game": {
    "title": "Roblox-Style Math Quest v4",
    "version": "4.0.0",
    "description": "Mobile-first educational math game with enhanced 3D graphics",
    "author": "Claude AI",
    "type": "educational-game"
  },
  "graphics": {
    "renderer": {
      "antialias": true,
      "shadowMapEnabled": true,
      "shadowMapType": "PCFSoftShadowMap",
      "toneMapping": "ACESFilmicToneMapping",
      "toneMappingExposure": 1.1,
      "pixelRatioMax": 2
    },
    "shadows": {
      "mapSize": {
        "width": 2048,
        "height": 2048
      },
      "camera": {
        "left": -50,
        "right": 50,
        "top": 50,
        "bottom": -50,
        "near": 1,
        "far": 100
      },
      "bias": -0.001
    },
    "postProcessing": {
      "bloom": {
        "enabled": true,
        "strength": 0.6,
        "radius": 0.4,
        "threshold": 0.85
      }
    },
    "fog": {
      "enabled": true,
      "color": "#06101f",
      "near": 50,
      "far": 150
    },
    "lighting": {
      "ambient": {
        "color": "#ffffff",
        "intensity": 0.4
      },
      "directional": {
        "color": "#ffeedd",
        "intensity": 1.5,
        "position": [20, 35, 15]
      },
      "pointLights": [
        {
          "name": "blueLight",
          "color": "#38bdf8",
          "intensity": 0.8,
          "distance": 40,
          "position": [-18, 8, 0]
        },
        {
          "name": "redLight",
          "color": "#ef4444",
          "intensity": 0.6,
          "distance": 30,
          "position": [40, 6, 0]
        }
      ]
    },
    "materials": {
      "ground": {
        "color": "#0d3a28",
        "roughness": 0.95,
        "metalness": 0.05
      },
      "water": {
        "color": "#0b3a66",
        "opacity": 0.85,
        "roughness": 0.3,
        "metalness": 0.7,
        "emissive": "#0b3a66",
        "emissiveIntensity": 0.1
      },
      "bridge": {
        "color": "#4b5563",
        "metalness": 0.2,
        "roughness": 0.7
      },
      "playerCharacter": {
        "color": "#22c55e",
        "emissive": "#22c55e",
        "emissiveIntensity": 0.2,
        "metalness": 0.1,
        "roughness": 0.8
      },
      "enemyCharacter": {
        "color": "#ef4444",
        "emissive": "#ef4444",
        "emissiveIntensity": 0.2,
        "metalness": 0.1,
        "roughness": 0.8
      },
      "coinParticle": {
        "color": "#facc15",
        "emissive": "#facc15",
        "emissiveIntensity": 0.5,
        "metalness": 0.9,
        "roughness": 0.2
      }
    },
    "sky": {
      "radius": 145,
      "segments": 40,
      "starCount": 400,
      "gradient": [
        {"stop": 0, "color": "#1e3a8a"},
        {"stop": 0.3, "color": "#0b2a66"},
        {"stop": 0.65, "color": "#06101f"},
        {"stop": 1, "color": "#020617"}
      ]
    },
    "water": {
      "animated": true,
      "waveSpeed": 800,
      "waveAmplitude": 0.15
    }
  },
  "gameplay": {
    "initialStats": {
      "level": 1,
      "coins": 0,
      "baseHp": 100,
      "correct": 0,
      "wrong": 0,
      "streak": 0
    },
    "progression": {
      "hpIncreasePerLevel": 10,
      "maxHp": 200,
      "coinsPerDefeat": {
        "base": 10,
        "perLevel": 5
      },
      "enemiesPerWave": {
        "base": 3,
        "scalingFactor": 0.5
      }
    },
    "weapons": {
      "fist": {
        "displayName": "Fist (Easy)",
        "damage": 10,
        "mode": "easy",
        "description": "Basic melee weapon for easy problems"
      },
      "pistol": {
        "displayName": "Pistol (Mid)",
        "damage": 18,
        "mode": "mid",
        "description": "Standard weapon for medium difficulty"
      },
      "ar": {
        "displayName": "AR (Burst)",
        "damage": 14,
        "mode": "mid",
        "chargeRequired": 2,
        "damageMultiplier": 2,
        "description": "Burst weapon requiring 2 correct answers"
      },
      "bomb": {
        "displayName": "Bomb (Hard)",
        "damage": 30,
        "mode": "hard",
        "areaOfEffect": true,
        "description": "AOE weapon affecting all enemies"
      }
    },
    "combat": {
      "streakBonus": {
        "threshold": 5,
        "damageMultiplier": 1.2
      },
      "wrongAnswerPenalty": {
        "speedMultiplier": 1.8,
        "duration": 3.0
      }
    },
    "enemies": {
      "baseHp": 40,
      "hpPerLevel": 10,
      "baseSpeed": 2.2,
      "speedPerLevel": 0.22,
      "spawnDistance": {
        "min": 42,
        "max": 60
      },
      "damageToBase": {
        "base": 15,
        "perLevel": 5
      }
    },
    "particles": {
      "coins": {
        "count": 8,
        "size": 0.25,
        "velocityRange": {
          "x": [-0.9, 0.9],
          "y": [2.5, 4.0],
          "z": [-0.9, 0.9]
        },
        "lifetime": {
          "min": 0.8,
          "max": 1.3
        },
        "gravity": 5.0
      }
    }
  },
  "questions": {
    "types": ["BODMAS", "Find X", "Physics", "Coords"],
    "difficultyModes": ["easy", "mid", "hard"],
    "physics": {
      "availableFromLevel": 3,
      "chance": 0.35
    },
    "coordinates": {
      "availableFromLevel": 5,
      "chance": 0.40
    },
    "scaling": {
      "difficultyScalePerLevel": 0.08,
      "maxScale": 1.6
    },
    "ranges": {
      "easy": {
        "addition": {"min": 3, "max": 25},
        "multiplication": {"min": 2, "max": 6},
        "division": {"min": 2, "max": 6}
      },
      "mid": {
        "addition": {"min": 5, "max": 45},
        "multiplication": {"min": 2, "max": 9},
        "division": {"min": 2, "max": 9}
      },
      "hard": {
        "addition": {"min": 10, "max": 80},
        "multiplication": {"min": 2, "max": 12},
        "division": {"min": 2, "max": 12}
      }
    }
  },
  "audio": {
    "enabled": true,
    "sounds": {
      "correct": {
        "frequencies": [660, 880],
        "duration": [0.07, 0.08],
        "type": "triangle",
        "gain": 0.06,
        "delay": 60
      },
      "wrong": {
        "frequency": 220,
        "duration": 0.10,
        "type": "sawtooth",
        "gain": 0.05
      },
      "coin": {
        "frequencies": [1040, 1240],
        "duration": 0.05,
        "type": "square",
        "gain": 0.04,
        "delay": 60
      },
      "attack": {
        "frequency": 440,
        "duration": 0.06,
        "type": "square",
        "gain": 0.05
      },
      "levelUp": {
        "frequencies": [880, 1100],
        "duration": 0.10,
        "type": "triangle",
        "gain": 0.07,
        "delay": 100
      }
    }
  },
  "ui": {
    "theme": {
      "colors": {
        "bg": "#06101f",
        "panel": "rgba(17,24,39,.74)",
        "panel2": "rgba(2,6,23,.55)",
        "stroke": "rgba(148,163,184,.22)",
        "accent": "rgba(56,189,248,.25)",
        "text": "#e5e7eb",
        "muted": "#94a3b8",
        "ok": "#22c55e",
        "bad": "#ef4444"
      },
      "borderRadius": "14px",
      "shadow": "0 18px 55px rgba(0,0,0,.35)"
    },
    "mobile": {
      "safeAreaInsets": true,
      "touchOptimized": true,
      "bottomSheet": true
    },
    "animations": {
      "transitionDuration": "0.2s",
      "hoverLift": "-1px",
      "activePress": "1px"
    }
  },
  "camera": {
    "fov": 55,
    "position": [0, 14, 30],
    "lookAt": [0, 6, 0],
    "near": 0.1,
    "far": 300
  },
  "scene": {
    "ground": {
      "size": [240, 240],
      "segments": [20, 20],
      "position": [0, 0, 0]
    },
    "water": {
      "size": [240, 70],
      "segments": [30, 15],
      "position": [0, 0.05, 0]
    },
    "bridge": {
      "position": [0, 5.2, 0],
      "width": 26,
      "height": 1.2,
      "depth": 8
    },
    "base": {
      "position": [-18, 2, 0],
      "size": [6, 4, 6]
    },
    "clouds": {
      "count": 16,
      "height": 22,
      "speedRange": [0.4, 0.8],
      "scaleRange": [0.9, 2.5]
    }
  },
  "performance": {
    "targetFrameRate": 60,
    "maxDeltaTime": 0.033,
    "powerPreference": "high-performance"
  },
  "features": {
    "shadows": true,
    "bloom": true,
    "fog": true,
    "animatedWater": true,
    "particleEffects": true,
    "pbrMaterials": true,
    "postProcessing": true,
    "deltaTimeAnimation": true,
    "mobileOptimized": true
  }
}
